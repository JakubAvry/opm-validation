# (iso / opcloud / both). Messages here are short; the report text comes from the catalogue.
# SHACL Core wherever it suffices; SHACL-SPARQL only where Core does not.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix opm:  <https://example.org/opm#> .
@prefix opms: <https://example.org/opm/shapes#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

opms:prefixes a owl:Ontology ;
    sh:declare [ sh:prefix "opm" ; sh:namespace "https://example.org/opm#"^^xsd:anyURI ] ,
               [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
               [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] .

# ---------------------------------------------------------------------------------------------- chapter 7

opms:OPM-7-006 a sh:NodeShape ; opm:rule "OPM-7-006" ; opm:profile "both" ;
    sh:targetClass opm:Process ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "duration is not positive" ;
        sh:select """
            SELECT $this ?value WHERE {
                { $this opm:maxDuration ?value } UNION { $this opm:minDuration ?value }
                UNION { ?l a opm:ExceptionLink ; opm:source $this ; opm:duration ?value }
                BIND (REPLACE(STR(?value), "^([0-9]+(?:[.,][0-9]+)?).*$", "$1") AS ?num)
                FILTER (REGEX(?num, "^[0-9]+(?:[.,][0-9]+)?$") && xsd:decimal(REPLACE(?num, ",", ".")) <= 0)
            }""" ] ;
    sh:severity sh:Violation .

opms:OPM-7-009 a sh:NodeShape ; opm:rule "OPM-7-009" ; opm:profile "both" ;
    sh:targetClass opm:Object ;
    sh:not [ sh:class opm:Process ] ;
    sh:severity sh:Violation ; sh:message "thing used both as an object and as a process" .

opms:OPM-7-017 a sh:NodeShape ; opm:rule "OPM-7-017" ; opm:profile "iso" ;
    sh:targetClass opm:Thing ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "default generic property stated for a linked thing" ;
        sh:select """
            SELECT $this ?value WHERE {
                { $this opm:affiliationStated ?value . FILTER (?value = "systemic") }
                UNION
                { $this opm:essenceStated ?value . ?model a opm:Model ; opm:primaryEssence ?value . }
                FILTER EXISTS { ?l a opm:Link . { ?l opm:object $this } UNION { ?l opm:process $this }
                                UNION { ?l opm:source $this } UNION { ?l opm:target $this } }
            }""" ] ;
    sh:severity sh:Warning .

opms:OPM-7-023 a sh:NodeShape ; opm:rule "OPM-7-023" ; opm:profile "both" ;
    sh:targetClass opm:Object ;
    sh:property [ sh:path [ sh:inversePath opm:stateOf ] ;
                  sh:qualifiedValueShape [ sh:property [ sh:path opm:isDefault ; sh:hasValue true ] ] ;
                  sh:qualifiedMaxCount 1 ] ;
    sh:severity sh:Violation ; sh:message "more than one default state" .

# ---------------------------------------------------------------------------------------------- chapter 8

opms:OPM-8-002 a sh:NodeShape ; opm:rule "OPM-8-002" ; opm:profile "both" ;
    sh:targetClass opm:Process ;
    sh:or (
        [ sh:property [ sh:path [ sh:inversePath opm:process ] ;
                        sh:qualifiedValueShape [ sh:class opm:TransformingLink ] ; sh:qualifiedMinCount 1 ] ]
        [ sh:property [ sh:path [ sh:inversePath opm:refines ] ;
                        sh:qualifiedValueShape [ sh:class opm:InZoom ] ; sh:qualifiedMinCount 1 ] ]
        [ sh:property [ sh:path [ sh:inversePath opm:distributedTo ] ;
                        sh:qualifiedValueShape [ sh:class opm:TransformingLink ] ; sh:qualifiedMinCount 1 ] ]
        [ sh:property [ sh:path ( [ sh:oneOrMorePath opm:hasPart ] [ sh:inversePath opm:process ] ) ;
                        sh:qualifiedValueShape [ sh:class opm:TransformingLink ] ; sh:qualifiedMinCount 1 ] ]
        [ sh:class opm:Object ]
    ) ;
    sh:severity sh:Violation ; sh:message "process transforms nothing" .

opms:OPM-8-004 a sh:NodeShape ; opm:rule "OPM-8-004" ; opm:profile "both" ;
    sh:targetClass opm:Object ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "object linked to a process by more than one procedural link" ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                ?l1 opm:object $this ; opm:process ?value ; a ?k1 ; opm:linkSpec ?x1 .
                ?l2 opm:object $this ; opm:process ?value ; a ?k2 ; opm:linkSpec ?x2 .
                FILTER (?k1 IN (opm:ConsumptionLink, opm:ResultLink, opm:EffectLink, opm:AgentLink, opm:InstrumentLink))
                FILTER (?k2 IN (opm:ConsumptionLink, opm:ResultLink, opm:EffectLink, opm:AgentLink, opm:InstrumentLink))
                FILTER ((?k1 != ?k2 || ?x1 != ?x2) && STR(?l1) < STR(?l2))
                OPTIONAL { ?l1 opm:inOPD ?d1 } OPTIONAL { ?l2 opm:inOPD ?d2 }
                FILTER ((!BOUND(?d1) && !BOUND(?d2)) || (BOUND(?d1) && BOUND(?d2) && ?d1 = ?d2))
                FILTER NOT EXISTS { ?f opm:member ?l1 , ?l2 }
                OPTIONAL { ?l1 opm:pathLabel ?p1 } OPTIONAL { ?l2 opm:pathLabel ?p2 }
                FILTER (!(BOUND(?p1) && BOUND(?p2) && ?p1 != ?p2))
                OPTIONAL { ?l1 opm:state|opm:fromState|opm:toState ?t1 }
                OPTIONAL { ?l2 opm:state|opm:fromState|opm:toState ?t2 }
                OPTIONAL { ?l1 opm:state|opm:fromState|opm:toState ?both .
                           ?l2 opm:state|opm:fromState|opm:toState ?both }
                FILTER (?k1 != ?k2 || !BOUND(?t1) || !BOUND(?t2) || BOUND(?both))
            }""" ] ;
    sh:severity sh:Violation .
# Links with different path labels belong to different execution paths (clause 13, Figure 43): not compared.
# Two links of one kind at different states are links of two object states (8.1.2 "an object or any one of
# its states", Figure 33 "consumes i inspected Blades and b - i new Blades"): reported only when one of them
# has no state or when they share a state.

opms:OPM-8-008 a sh:NodeShape ; opm:rule "OPM-8-008" ; opm:profile "both" ;
    sh:targetClass opm:Process ;
    sh:or (
        [ sh:property [ sh:path [ sh:inversePath opm:process ] ; sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:or ( [ sh:class opm:ConsumptionLink ] [ sh:class opm:EffectLink ]
                                                         [ sh:class opm:EnablingLink ] ) ] ] ]
        [ sh:property [ sh:path ( [ sh:oneOrMorePath [ sh:inversePath opm:subprocessOf ] ]
                                  [ sh:inversePath opm:process ] ) ; sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:or ( [ sh:class opm:ConsumptionLink ] [ sh:class opm:EffectLink ]
                                                         [ sh:class opm:EnablingLink ] ) ] ] ]
        [ sh:property [ sh:path [ sh:inversePath opm:target ] ; sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:or ( [ sh:class opm:InvocationLink ] [ sh:class opm:ExceptionLink ] ) ] ] ]
        [ sh:property [ sh:path ( opm:subprocessOf [ sh:inversePath opm:process ] ) ; sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:or ( [ sh:class opm:ConsumptionLink ] [ sh:class opm:EffectLink ]
                                                         [ sh:class opm:EnablingLink ] ) ] ] ]
        [ sh:property [ sh:path opm:subprocessOf ; sh:minCount 1 ] ]
        [ sh:class opm:Object ]
    ) ;
    sh:severity sh:Violation ; sh:message "process has no preprocess object" .
# Subprocesses are exempt: the implicit invocation of 14.2.2.1 brings the interim object of 9.5.2.5.1 (NOTE).

opms:OPM-8-010 a sh:NodeShape ; opm:rule "OPM-8-010" ; opm:profile "both" ;
    sh:targetClass opm:Process ;
    sh:or (
        [ sh:property [ sh:path [ sh:inversePath opm:process ] ; sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:or ( [ sh:class opm:ResultLink ] [ sh:class opm:EffectLink ]
                                                         [ sh:class opm:EnablingLink ] ) ] ] ]
        [ sh:property [ sh:path ( [ sh:oneOrMorePath [ sh:inversePath opm:subprocessOf ] ]
                                  [ sh:inversePath opm:process ] ) ; sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:or ( [ sh:class opm:ResultLink ] [ sh:class opm:EffectLink ]
                                                         [ sh:class opm:EnablingLink ] ) ] ] ]
        [ sh:property [ sh:path [ sh:inversePath opm:source ] ; sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:class opm:InvocationLink ] ] ]
        [ sh:property [ sh:path ( opm:subprocessOf [ sh:inversePath opm:process ] ) ; sh:qualifiedMinCount 1 ;
                        sh:qualifiedValueShape [ sh:or ( [ sh:class opm:ResultLink ] [ sh:class opm:EffectLink ]
                                                         [ sh:class opm:EnablingLink ] ) ] ] ]
        [ sh:property [ sh:path opm:subprocessOf ; sh:minCount 1 ] ]
        [ sh:class opm:Object ]
    ) ;
    sh:severity sh:Violation ; sh:message "process has no postprocess object" .

# ---------------------------------------------------------------------------------------------- chapter 9

opms:OPM-9-001 a sh:NodeShape ; opm:rule "OPM-9-001" ; opm:profile "both" ;
    sh:targetClass opm:TransformingLink ;
    sh:property [ sh:path opm:process ; sh:minCount 1 ; sh:maxCount 1 ; sh:not [ sh:class opm:Object ] ] ;
    sh:property [ sh:path opm:object ; sh:minCount 1 ; sh:maxCount 1 ; sh:not [ sh:class opm:Process ] ] ;
    sh:severity sh:Violation ; sh:message "transforming link must connect a process with an object" .

opms:OPM-9-021 a sh:NodeShape ; opm:rule "OPM-9-021" ; opm:profile "both" ;
    sh:targetClass opm:EnablingLink ;
    sh:property [ sh:path opm:process ; sh:minCount 1 ; sh:maxCount 1 ; sh:not [ sh:class opm:Object ] ] ;
    sh:property [ sh:path opm:object ; sh:minCount 1 ; sh:maxCount 1 ; sh:not [ sh:class opm:Process ] ] ;
    sh:severity sh:Violation ; sh:message "enabling link must connect an object with a process" .

opms:OPM-9-028 a sh:NodeShape ; opm:rule "OPM-9-028" ; opm:profile "both" ;
    sh:targetClass opm:AgentLink ;
    sh:property [ sh:path ( opm:object opm:isHuman ) ; sh:in ( true ) ] ;
    sh:severity sh:Violation ; sh:message "agent is not a human" .

opms:OPM-9-032 a sh:NodeShape ; opm:rule "OPM-9-032" ; opm:profile "both" ;
    sh:targetClass opm:InstrumentLink ;
    sh:property [ sh:path ( opm:object opm:isHuman ) ; sh:in ( false ) ] ;
    sh:severity sh:Violation ; sh:message "instrument is a human" .

opms:OPM-9-036 a sh:NodeShape ; opm:rule "OPM-9-036" ; opm:profile "both" ;
    sh:targetObjectsOf opm:state, opm:fromState, opm:toState, opm:sourceState, opm:targetState ;
    sh:targetSubjectsOf opm:markSentence, opm:valueSentence ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "state is not a declared state of its object" ;
        sh:select """
            SELECT $this WHERE {
                $this a opm:State .
                FILTER NOT EXISTS { $this opm:declared true }
                FILTER NOT EXISTS {
                    $this opm:stateOf ?f ; opm:name ?n . ?f opm:featureOf ?o ; opm:featureName ?fn .
                    ?o (opm:specializes|opm:instanceOf)+ ?anc .
                    ?af opm:featureOf ?anc ; opm:featureName ?fn . ?as opm:stateOf ?af ; opm:name ?n ; opm:declared true .
                }
            }""" ] ;
    sh:severity sh:Violation .
# A specialization or instance inherits the possible values of an attribute, not the states of the object itself.

opms:OPM-9-051 a sh:NodeShape ; opm:rule "OPM-9-051" ; opm:profile "both" ;
    sh:targetClass opm:ResultLink ;
    sh:property [ sh:severity sh:Warning ; sh:path ( opm:state opm:isInitial ) ; sh:in ( false ) ] ;
    sh:severity sh:Warning ; sh:message "result link to the initial state" .

opms:OPM-9-054 a sh:NodeShape ; opm:rule "OPM-9-054" ; opm:profile "both" ;
    sh:targetClass opm:ChangeLink ;
    sh:property [ sh:path opm:fromState ; sh:disjoint opm:toState ] ;
    sh:severity sh:Violation ; sh:message "change from a state to the same state" .

opms:OPM-9-087 a sh:NodeShape ; opm:rule "OPM-9-087" ; opm:profile "both" ;
    sh:targetClass opm:InvocationLink, opm:ExceptionLink ;
    sh:property [ sh:path opm:source ; sh:minCount 1 ; sh:not [ sh:class opm:Object ] ] ;
    sh:property [ sh:path opm:target ; sh:minCount 1 ; sh:not [ sh:class opm:Object ] ] ;
    sh:severity sh:Violation ; sh:message "invocation or exception link must connect two processes" .

opms:OPM-9-170 a sh:NodeShape ; opm:rule "OPM-9-170" ; opm:profile "both" ;
    sh:targetSubjectsOf opm:minDurationValue ;
    sh:property [ sh:path opm:minDurationValue ; sh:lessThanOrEquals opm:maxDurationValue ] ;
    sh:severity sh:Warning ; sh:message "minimal duration exceeds maximal duration" .

# ---------------------------------------------------------------------------------------------- chapter 10

opms:OPM-10-001 a sh:NodeShape ; opm:rule "OPM-10-001" ; opm:profile "both" ;
    sh:targetClass opm:AggregationLink, opm:GeneralizationLink, opm:ClassificationLink, opm:TaggedLink ;
    sh:not [ sh:or (
        [ sh:property [ sh:path opm:source ; sh:class opm:Object ] ; sh:property [ sh:path opm:target ; sh:class opm:Process ] ]
        [ sh:property [ sh:path opm:source ; sh:class opm:Process ] ; sh:property [ sh:path opm:target ; sh:class opm:Object ] ]
    ) ] ;
    sh:severity sh:Violation ; sh:message "structural link between an object and a process" .

opms:OPM-10-020 a sh:NodeShape ; opm:rule "OPM-10-020" ; opm:profile "both" ;
    sh:targetClass opm:FundamentalLink ;
    sh:property [ sh:path opm:source ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path opm:target ; sh:minCount 1 ] ;
    sh:severity sh:Violation ; sh:message "fundamental relation without one refineable and a refinee" .

opms:OPM-10-037 a sh:NodeShape ; opm:rule "OPM-10-037" ; opm:profile "both" ;
    sh:targetClass opm:ExhibitionLink ;
    sh:or (
        [ sh:not [ sh:property [ sh:path opm:featureRole ; sh:hasValue "attribute" ] ] ]
        [ sh:property [ sh:path opm:target ; sh:not [ sh:class opm:Process ] ] ]
    ) ;
    sh:or (
        [ sh:not [ sh:property [ sh:path opm:featureRole ; sh:hasValue "operation" ] ] ]
        [ sh:property [ sh:path opm:target ; sh:not [ sh:class opm:Object ] ] ]
    ) ;
    sh:severity sh:Violation ; sh:message "attribute that is a process or operation that is an object" .

opms:OPM-10-050 a sh:NodeShape ; opm:rule "OPM-10-050" ; opm:profile "both" ;
    sh:targetSubjectsOf opm:featureOf ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "feature not exhibited by its exhibitor or an ancestor" ;
        sh:select """
            SELECT $this ?value WHERE {
                $this opm:featureOf ?value ; opm:featureName ?fname .
                FILTER NOT EXISTS {
                    ?value (opm:specializes|opm:instanceOf)* ?anc .
                    ?anc opm:hasFeature ?f . ?f opm:featureName ?fname .
                }
            }""" ] ;
    sh:severity sh:Violation .

# focus = the later specialization, value = the earlier one with the same fixed values
opms:OPM-10-068 a sh:NodeShape ; opm:rule "OPM-10-068" ; opm:profile "both" ;
    sh:targetSubjectsOf opm:specializes ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "two specializations fix the same attribute values" ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                $this opm:specializes ?g . ?value opm:specializes ?g . FILTER (STR(?value) < STR($this))
                ?a opm:featureOf $this ; opm:value ?v .
                FILTER NOT EXISTS {
                    { ?x opm:featureOf $this ; opm:featureName ?n ; opm:value ?vx .
                      OPTIONAL { ?y opm:featureOf ?value ; opm:featureName ?n ; opm:value ?vy . FILTER (?vy = ?vx) }
                      FILTER (!BOUND(?y)) }
                    UNION
                    { ?y2 opm:featureOf ?value ; opm:featureName ?n2 ; opm:value ?vy2 .
                      OPTIONAL { ?x2 opm:featureOf $this ; opm:featureName ?n2 ; opm:value ?vx2 . FILTER (?vx2 = ?vy2) }
                      FILTER (!BOUND(?x2)) }
                }
            }""" ] ;
    sh:severity sh:Warning .
# OPTIONAL + !BOUND instead of a nested FILTER NOT EXISTS (rdflib 7 evaluates the nested form wrongly).

opms:OPM-10-070 a sh:NodeShape ; opm:rule "OPM-10-070" ; opm:profile "both" ;
    sh:targetSubjectsOf opm:value ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "value outside the range given by the class" ;
        sh:select """
            SELECT $this ?value WHERE {
                $this opm:value ?value ; opm:featureName ?fname ; opm:featureOf ?owner .
                ?owner (opm:specializes|opm:instanceOf)* ?anc .
                ?attr opm:featureOf ?anc ; opm:featureName ?fname ; opm:rangeMin ?min ; opm:rangeMax ?max .
                BIND (xsd:decimal(REPLACE(STR(?value), ",", ".")) AS ?v)
                BIND (xsd:decimal(REPLACE(STR(?min), ",", ".")) AS ?lo)
                BIND (xsd:decimal(REPLACE(STR(?max), ",", ".")) AS ?hi)
                FILTER (BOUND(?v) && BOUND(?lo) && BOUND(?hi) && (?v < ?lo || ?v > ?hi))
            }""" ] ;
    sh:severity sh:Violation .

opms:OPM-10-085 a sh:NodeShape ; opm:rule "OPM-10-085" ; opm:profile "both" ;
    sh:targetSubjectsOf opm:value ;
    sh:property [ sh:path opm:value ; sh:maxCount 1 ] ;
    sh:severity sh:Violation ; sh:message "attribute with more than one value" .

# ---------------------------------------------------------------------------------------------- chapter 11

opms:OPM-11-023 a sh:NodeShape ; opm:rule "OPM-11-023" ; opm:profile "both" ;
    sh:targetClass opm:Range ;
    sh:property [ sh:path opm:lower ; sh:lessThanOrEquals opm:upper ] ;
    sh:severity sh:Warning ; sh:message "lower bound of a range exceeds its upper bound" .

# ---------------------------------------------------------------------------------------------- chapter 12

opms:OPM-12-002 a sh:NodeShape ; opm:rule "OPM-12-002" ; opm:profile "both" ;
    sh:targetClass opm:ProceduralLink ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "links with AND semantics in separate sentences" ;
        sh:select """
            SELECT $this ?value WHERE {
                $this a ?cls ; opm:process ?p ; opm:sentence ?s .
                FILTER(?cls IN (opm:ConsumptionLink, opm:ResultLink, opm:EffectLink, opm:AgentLink, opm:InstrumentLink))
                ?value a ?cls ; opm:process ?p ; opm:sentence ?s0 .
                ?s opm:line ?l ; opm:column ?c ; opm:text ?t .
                ?s0 opm:line ?l0 ; opm:column ?c0 ; opm:text ?t0 .
                FILTER(?l0 < ?l || (?l0 = ?l && ?c0 < ?c))
                FILTER(?t0 != ?t)
                BIND(EXISTS { $this a opm:ChangeLink } AS ?change)
                BIND(EXISTS { ?value a opm:ChangeLink } AS ?change0)
                FILTER(?change = ?change0)
                BIND(EXISTS { $this opm:fromState ?fs } AS ?from)
                BIND(EXISTS { ?value opm:fromState ?fs0 } AS ?from0)
                BIND(EXISTS { $this opm:toState ?ts } AS ?to)
                BIND(EXISTS { ?value opm:toState ?ts0 } AS ?to0)
                FILTER(?from = ?from0 && ?to = ?to0)
                OPTIONAL { $this opm:modifier ?m }
                OPTIONAL { ?value opm:modifier ?m0 }
                FILTER(!BOUND(?m) && !BOUND(?m0))
                OPTIONAL { ?f opm:member $this }
                OPTIONAL { ?f0 opm:member ?value }
                FILTER(!BOUND(?f) && !BOUND(?f0))
                OPTIONAL { $this opm:inOPD ?d }
                OPTIONAL { ?value opm:inOPD ?d0 }
                FILTER((!BOUND(?d) && !BOUND(?d0)) || ?d = ?d0)
                OPTIONAL { $this opm:pathLabel ?pl }
                OPTIONAL { ?value opm:pathLabel ?pl0 }
                FILTER((!BOUND(?pl) && !BOUND(?pl0)) || ?pl = ?pl0)
            }""" ] ;
    sh:severity sh:Violation .

opms:OPM-12-022 a sh:NodeShape ; opm:rule "OPM-12-022" ; opm:profile "both" ;
    sh:targetClass opm:Fan ;
    sh:or (
        [ sh:property [ sh:path ( opm:member opm:probability ) ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path opm:member ; sh:node [ sh:property [ sh:path opm:probability ; sh:minCount 1 ] ] ] ]
    ) ;
    sh:severity sh:Violation ; sh:message "probability given for some links of the fan only" .

opms:OPM-12-023 a sh:NodeShape ; opm:rule "OPM-12-023" ; opm:profile "both" ;
    sh:targetClass opm:Fan ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "probabilities do not add up to 1" ;
        sh:select """
            SELECT $this (SUM(?p) AS ?value) WHERE {
                $this opm:member ?l . ?l opm:probability ?raw .
                FILTER NOT EXISTS { $this opm:member ?l3 . OPTIONAL { ?l3 opm:probability ?r3 } FILTER (!BOUND(?r3)) }
                FILTER NOT EXISTS { $this opm:member ?l2 . ?l2 opm:probability ?r2 .
                                    FILTER (!REGEX(STR(?r2), "^[0-9]+(?:[.,][0-9]+)?$")) }
                BIND (xsd:decimal(REPLACE(STR(?raw), ",", ".")) AS ?p)
            } GROUP BY $this HAVING (ABS(SUM(?p) - 1) > 0.000001)""" ] ;
    sh:severity sh:Violation .
# Only a complete fan is summed; a member without a probability is reported by OPM-12-022.
# (OPTIONAL + !BOUND, because rdflib 7 evaluates a FILTER NOT EXISTS nested in another one wrongly.)

# ---------------------------------------------------------------------------------------------- chapter 13

opms:OPM-13-001 a sh:NodeShape ; opm:rule "OPM-13-001" ; opm:profile "both" ;
    sh:targetClass opm:Process ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "path label without its counterpart" ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                ?l opm:process $this ; opm:pathLabel ?value .
                BIND (EXISTS { ?i opm:process $this ; opm:pathLabel ?value ; a ?ki .
                               FILTER (?ki IN (opm:ConsumptionLink, opm:EffectLink, opm:EnablingLink)) } AS ?hasIn)
                BIND (EXISTS { ?o opm:process $this ; opm:pathLabel ?value ; a ?ko .
                               FILTER (?ko IN (opm:ResultLink, opm:EffectLink)) } AS ?hasOut)
                FILTER (!?hasIn || !?hasOut)
            }""" ] ;
    sh:severity sh:Violation .

# ---------------------------------------------------------------------------------------------- chapter 14

opms:OPM-14-020 a sh:NodeShape ; opm:rule "OPM-14-020" ; opm:profile "both" ;
    sh:targetSubjectsOf opm:refinee ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "refinement cycle" ;
        sh:select """SELECT $this WHERE { $this opm:refinee+ $this }""" ] ;
    sh:severity sh:Violation .

opms:OPM-14-050 a sh:NodeShape ; opm:rule "OPM-14-050" ; opm:profile "both" ;
    sh:targetClass opm:ProceduralLink ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "link of an in-zoomed process has no counterpart in the OPD of the in-zoom" ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                $this opm:object ?o ; opm:process ?value ; opm:inOPD ?d .
                ?z a opm:InZoom ; opm:refines ?value ; opm:childOPD ?c .
                ?c opm:parentOPD ?d .
                FILTER NOT EXISTS {
                    ?l a opm:ProceduralLink ; opm:inOPD ?c ; opm:object ?o2 .
                    ?o2 (opm:featureOf|^opm:hasPart|^opm:hasSpecialization|^opm:hasInstance)* ?o .
                }
            }""" ] ;
    sh:severity sh:Warning .

opms:OPM-14-051 a sh:NodeShape ; opm:rule "OPM-14-051" ; opm:profile "both" ;
    sh:targetClass opm:ConsumptionLink, opm:ResultLink ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "consumption or result link on an in-zoomed process" ;
        sh:select """
            SELECT $this ?value WHERE {
                $this opm:process ?value ; opm:inOPD ?d .
                ?z a opm:InZoom ; opm:refines ?value ; opm:childOPD ?d .
            }""" ] ;
    sh:severity sh:Violation .

opms:OPM-14-054 a sh:NodeShape ; opm:rule "OPM-14-054" ; opm:profile "both" ;
    sh:targetClass opm:EventLink, opm:InvocationLink, opm:ExceptionLink ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "event from outside starts a subprocess" ;
        sh:select """
            SELECT $this ?value WHERE {
                {
                    $this opm:process ?sub ; opm:object ?o .
                    ?sub opm:subprocessOf+ ?value .
                    FILTER NOT EXISTS { ?o opm:interimOf ?value }
                    FILTER NOT EXISTS { ?r a opm:ResultLink ; opm:object ?o ; opm:process ?s2 . ?s2 opm:subprocessOf+ ?value }
                    FILTER NOT EXISTS { ?o opm:subprocessOf ?value }
                } UNION {
                    $this opm:source ?src ; opm:target ?sub .
                    ?sub opm:subprocessOf+ ?value .
                    FILTER (?src != ?value)
                    FILTER NOT EXISTS { ?src opm:subprocessOf+ ?value }
                }
            }""" ] ;
    sh:severity sh:Violation .
# Second branch: an invocation or exception link is an event too (9.5.2.5.1 "process invocation shall be an
# event"; both are links of 9.5.2 / 9.5.4 that initiate their destination): from a process outside the
# in-zoomed process to one of its subprocesses.

opms:OPM-14-055 a sh:NodeShape ; opm:rule "OPM-14-055" ; opm:profile "both" ;
    sh:targetClass opm:ChangeLink ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "change on an in-zoomed process or split in the wrong order" ;
        sh:select """
            SELECT $this ?value WHERE {
                { $this opm:process ?value ; opm:inOPD ?d . ?z a opm:InZoom ; opm:refines ?value ; opm:childOPD ?d .
                  $this opm:fromState ?f ; opm:toState ?t . }
                UNION
                { $this opm:process ?out ; opm:object ?o ; opm:toState ?t .
                  FILTER NOT EXISTS { $this opm:fromState ?any }
                  ?in a opm:ChangeLink ; opm:process ?value ; opm:object ?o ; opm:fromState ?f .
                  FILTER NOT EXISTS { ?in opm:toState ?any2 }
                  ?out opm:subprocessOf ?p ; opm:stepOrder ?n1 . ?value opm:subprocessOf ?p ; opm:stepOrder ?n2 .
                  FILTER (?n2 > ?n1) }
            }""" ] ;
    sh:severity sh:Violation .

opms:OPM-14-061 a sh:NodeShape ; opm:rule "OPM-14-061" ; opm:profile "both" ;
    sh:targetSubjectsOf opm:parentOPD ;
    sh:property [ sh:path [ sh:oneOrMorePath opm:parentOPD ] ;
                  sh:qualifiedValueShape [ sh:property [ sh:path opm:parentOPD ; sh:maxCount 0 ] ] ;
                  sh:qualifiedMinCount 1 ] ;
    sh:severity sh:Violation ; sh:message "OPD is not connected to the root of the OPD tree" .

opms:OPM-14-062 a sh:NodeShape ; opm:rule "OPM-14-062" ; opm:profile "both" ;
    sh:targetClass opm:OPD ;
    sh:or ( [ sh:property [ sh:path opm:label ; sh:hasValue "SD" ] ]
            [ sh:property [ sh:path opm:parentOPD ; sh:minCount 1 ; sh:maxCount 1 ] ]
            [ sh:property [ sh:path [ sh:inversePath opm:heads ] ; sh:maxCount 0 ] ] ) ;
    sh:severity sh:Violation ; sh:message "OPD without exactly one parent OPD" .

opms:OPM-14-067 a sh:NodeShape ; opm:rule "OPM-14-067" ; opm:profile "both" ;
    sh:targetClass opm:OPD ;
    sh:or (
        [ sh:not [ sh:property [ sh:path opm:label ; sh:hasValue "SD" ] ] ]
        [ sh:property [ sh:path [ sh:inversePath opm:heads ] ; sh:maxCount 1 ] ]
    ) ;
    sh:severity sh:Violation ; sh:message "not exactly one SD" .

opms:OPM-14-068 a sh:NodeShape ; opm:rule "OPM-14-068" ; opm:profile "both" ;
    sh:targetClass opm:OPD ;
    sh:or (
        [ sh:not [ sh:property [ sh:path opm:label ; sh:hasValue "SD" ] ] ]
        [ sh:property [ sh:path [ sh:inversePath opm:shownIn ] ;
                        sh:qualifiedValueShape [ sh:class opm:Process ;
                                                 sh:property [ sh:path opm:affiliation ; sh:hasValue "systemic" ] ;
                                                 sh:not [ sh:class opm:Object ] ] ;
                        sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ] ]
    ) ;
    sh:severity sh:Violation ; sh:message "SD does not have exactly one systemic process" .

opms:OPM-14-069 a sh:NodeShape ; opm:rule "OPM-14-069" ; opm:profile "both" ;
    sh:targetClass opm:Refinement ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "child OPD in-zooms another process than the edge label says" ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                $this opm:kind "in-zooming" ; opm:child ?d ; opm:refines ?t .
                ?z a opm:InZoom ; opm:childOPD ?d ; opm:refines ?value .
                FILTER NOT EXISTS { ?z2 a opm:InZoom ; opm:childOPD ?d ; opm:refines ?t }
            }""" ] ;
    sh:severity sh:Violation .

opms:OPM-14-081 a sh:NodeShape ; opm:rule "OPM-14-081" ; opm:profile "both" ;
    sh:targetClass opm:Object ;
    sh:property [ sh:path opm:consumedBy ;
                  sh:disjoint opm:yieldedBy, opm:affectedBy, opm:agentOf, opm:instrumentOf ] ;
    sh:property [ sh:path opm:yieldedBy ; sh:disjoint opm:affectedBy, opm:agentOf, opm:instrumentOf ] ;
    sh:property [ sh:path opm:affectedBy ; sh:disjoint opm:agentOf, opm:instrumentOf ] ;
    sh:property [ sh:path opm:agentOf ; sh:disjoint opm:instrumentOf ] ;
    sh:severity sh:Violation ; sh:message "the object has two different roles for one process" .

# focus = the link in the abstract OPD, value = the kind that prevails among the links to the subprocesses
opms:OPM-14-086 a sh:NodeShape ; opm:rule "OPM-14-086" ; opm:profile "both" ;
    sh:targetClass opm:ProceduralLink ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "abstract link is not the prevailing link to the subprocesses" ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                $this opm:object ?b ; opm:process ?p ; opm:inOPD ?d .
                ?z a opm:InZoom ; opm:refines ?p ; opm:childOPD ?d1 . FILTER (?d1 != ?d)
                ?c a opm:ProceduralLink ; opm:object ?b ; opm:process ?s . ?s opm:subprocessOf ?p .
                BIND (EXISTS { ?c1 a opm:ConsumptionLink ; opm:object ?b ; opm:process ?s1 . ?s1 opm:subprocessOf ?p } AS ?hc)
                BIND (EXISTS { ?c2 a opm:ResultLink ; opm:object ?b ; opm:process ?s2 . ?s2 opm:subprocessOf ?p } AS ?hr)
                BIND (EXISTS { ?c3 a opm:EffectLink ; opm:object ?b ; opm:process ?s3 . ?s3 opm:subprocessOf ?p } AS ?he)
                BIND (EXISTS { ?c4 a opm:AgentLink ; opm:object ?b ; opm:process ?s4 . ?s4 opm:subprocessOf ?p } AS ?ha)
                BIND (IF(?hc && ?hr, opm:EffectLink, IF(?hc, opm:ConsumptionLink, IF(?hr, opm:ResultLink,
                      IF(?he, opm:EffectLink, IF(?ha, opm:AgentLink, opm:InstrumentLink))))) AS ?value)
                FILTER NOT EXISTS { $this a ?value }
                FILTER (!(?value = opm:EffectLink && !?hc && !?hr && EXISTS { $this a opm:EnablingLink }))
            }""" ] ;
    sh:severity sh:Violation .
# Kinds only; event and condition modifiers are compared by OPM-14-091. An enabler that the subprocesses
# only affect is not reported (NOTE 2 of 14.2.2.4.3, N-050: whether it returns to its initial state is not known).

# focus = the later link, value = the earlier one
opms:OPM-14-088 a sh:NodeShape ; opm:rule "OPM-14-088" ; opm:profile "both" ;
    sh:targetClass opm:TransformingLink ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "impossible order of links within an in-zoomed process" ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                $this opm:object ?o ; opm:process ?s2 ; a ?k2 . ?s2 opm:subprocessOf ?p ; opm:stepOrder ?n2 .
                ?value opm:object ?o ; opm:process ?s1 ; a ?k1 . ?s1 opm:subprocessOf ?p ; opm:stepOrder ?n1 .
                FILTER (?n2 > ?n1)
                FILTER NOT EXISTS { $this a opm:ChangeLink . ?value a opm:ChangeLink }
                FILTER NOT EXISTS { ?value opm:modifier "condition" } FILTER NOT EXISTS { $this opm:modifier "condition" }
                FILTER ((?k1 = opm:ConsumptionLink && (?k2 = opm:ConsumptionLink || ?k2 = opm:EffectLink))
                     || (?k1 = opm:EffectLink && ?k2 = opm:ResultLink)
                     || (?k1 = opm:ResultLink && ?k2 = opm:ResultLink))
            }""" ] ;
    sh:severity sh:Warning .

# focus = the link in the abstract OPD, value = the modifier it should have ("condition" or "none")
opms:OPM-14-091 a sh:NodeShape ; opm:rule "OPM-14-091" ; opm:profile "both" ;
    sh:targetClass opm:ProceduralLink ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "abstract link has not the strongest modifier of the links to the subprocesses" ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                $this opm:object ?b ; opm:process ?p ; opm:inOPD ?d .
                ?z a opm:InZoom ; opm:refines ?p ; opm:childOPD ?d1 . FILTER (?d1 != ?d)
                ?c a opm:ProceduralLink ; opm:object ?b ; opm:process ?s . ?s opm:subprocessOf ?p .
                BIND (EXISTS { ?c1 a opm:ConsumptionLink ; opm:object ?b ; opm:process ?s1 . ?s1 opm:subprocessOf ?p } AS ?hc)
                BIND (EXISTS { ?c2 a opm:ResultLink ; opm:object ?b ; opm:process ?s2 . ?s2 opm:subprocessOf ?p } AS ?hr)
                BIND (EXISTS { ?c3 a opm:EffectLink ; opm:object ?b ; opm:process ?s3 . ?s3 opm:subprocessOf ?p } AS ?he)
                BIND (EXISTS { ?c4 a opm:AgentLink ; opm:object ?b ; opm:process ?s4 . ?s4 opm:subprocessOf ?p } AS ?ha)
                FILTER (!(?hc && ?hr))
                BIND (IF(?hc, opm:ConsumptionLink, IF(?hr, opm:ResultLink,
                      IF(?he, opm:EffectLink, IF(?ha, opm:AgentLink, opm:InstrumentLink)))) AS ?kind)
                FILTER EXISTS { $this a ?kind }
                BIND (EXISTS { ?n a ?kind ; opm:object ?b ; opm:process ?sn . ?sn opm:subprocessOf ?p .
                               OPTIONAL { ?n opm:modifier ?mm } FILTER (!BOUND(?mm) || ?mm != "condition") } AS ?strong)
                BIND (EXISTS { $this opm:modifier "condition" } AS ?cond)
                FILTER (?cond = ?strong)
                BIND (IF(?strong, "none", "condition") AS ?value)
            }""" ] ;
    sh:severity sh:Warning .

opms:OPM-14-093 a sh:NodeShape ; opm:rule "OPM-14-093" ; opm:profile "both" ;
    sh:targetClass opm:Thing ;
    sh:property [ sh:severity sh:Warning ; sh:path [ sh:inversePath opm:refines ] ; sh:qualifiedValueShape [ sh:class opm:InZoom ] ;
                  sh:qualifiedMaxCount 1 ] ;
    sh:severity sh:Warning ; sh:message "process in-zoomed more than once" .

opms:OPM-14-094 a sh:NodeShape ; opm:rule "OPM-14-094" ; opm:profile "both" ;
    sh:targetClass opm:Refinement ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "refined thing is not in the parent OPD" ;
        sh:select """
            SELECT $this ?value WHERE {
                $this opm:parent ?value ; opm:refines ?t .
                FILTER NOT EXISTS { ?t opm:shownIn ?value }
            }""" ] ;
    sh:severity sh:Violation .

# ---------------------------------------------------------------------------------------------- Annex B (W)

opms:OPM-B-002 a sh:NodeShape ; opm:rule "OPM-B-002" ; opm:profile "both" ;
    sh:targetClass opm:OPD ;
    sh:property [ sh:severity sh:Warning ; sh:path [ sh:inversePath opm:shownIn ] ; sh:maxCount 25 ] ;
    sh:severity sh:Warning ; sh:message "OPD with more than 25 things" .

opms:OPM-B-006 a sh:NodeShape ; opm:rule "OPM-B-006" ; opm:profile "both" ;
    sh:targetClass opm:Object ;
    sh:property [ sh:severity sh:Warning ; sh:path [ sh:inversePath opm:hasPart ] ; sh:maxCount 1 ] ;
    sh:severity sh:Warning ; sh:message "object is a part in more than one context" .

opms:OPM-B-007 a sh:NodeShape ; opm:rule "OPM-B-007" ; opm:profile "both" ;
    sh:targetClass opm:Process ;
    sh:property [ sh:severity sh:Warning ; sh:path opm:name ; sh:pattern "^(?:\\S+\\s+){0,3}\\S*ing(?:\\s+of\\s+.+)?$" ] ;
    sh:severity sh:Warning ; sh:message "process name does not end in -ing or has more than four words" .
# An operation named after its exhibitor ("Heating of Kettle", 10.3.3.2.2) is checked on its own name.

opms:OPM-B-008 a sh:NodeShape ; opm:rule "OPM-B-008" ; opm:profile "both" ;
    sh:targetClass opm:State ;
    sh:sparql [ sh:prefixes opms:prefixes ; sh:message "state named with the gerund of a process" ;
        sh:select """
            SELECT DISTINCT $this ?value WHERE {
                $this opm:name ?value .
                FILTER (REGEX(?value, "ing$"))
                ?p a opm:Process ; opm:name ?pn .
                FILTER (CONTAINS(CONCAT(" ", LCASE(?pn), " "), CONCAT(" ", LCASE(?value), " ")))
            }""" ] ;
    sh:severity sh:Warning .

# ---------------------------------------------------------------------------------------------- OPCloud profile

opms:OPC-001 a sh:NodeShape ; opm:rule "OPC-001" ; opm:profile "opcloud" ;
    sh:targetClass opm:Object ;
    sh:property [ sh:path [ sh:inversePath opm:stateOf ] ;
                  sh:qualifiedValueShape [ sh:property [ sh:path opm:isFinal ; sh:hasValue true ] ] ;
                  sh:qualifiedMaxCount 1 ] ;
    sh:severity sh:Violation ; sh:message "more than one final state (OPCloud)" .

opms:OPC-002 a sh:NodeShape ; opm:rule "OPC-002" ; opm:profile "opcloud" ;
    sh:targetSubjectsOf opm:subprocessOf ;
    sh:or (
        [ sh:not [ sh:property [ sh:path opm:essence ; sh:hasValue "physical" ] ] ]
        [ sh:property [ sh:path opm:subprocessOf ;
                        sh:not [ sh:property [ sh:path opm:essence ; sh:hasValue "informatical" ] ] ] ]
    ) ;
    sh:severity sh:Violation ; sh:message "physical subprocess inside an informatical process (OPCloud)" .
